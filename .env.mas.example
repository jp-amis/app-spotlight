# Mac App Store build config — copy this file to `.env.mas` and fill it in.
#   cp .env.mas.example .env.mas
# `.env.mas` is git-ignored. It is sourced by the build scripts, so KEEP THE QUOTES
# (the identity strings contain spaces and parentheses).

# Your 10-character Apple Team ID (developer.apple.com → Membership).
TEAM_ID="XXXXXXXXXX"

# The app's bundle identifier. Must match the App ID + provisioning profile.
BUNDLE_ID="com.yourname.spotlight"

# Signing identities — copy verbatim from: security find-identity -v -p codesigning
APPLE_DIST_IDENTITY="Apple Distribution: YOUR NAME (XXXXXXXXXX)"
APPLE_INSTALLER_IDENTITY="3rd Party Mac Developer Installer: YOUR NAME (XXXXXXXXXX)"
