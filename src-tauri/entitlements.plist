<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Required for WKWebView to load the (local) frontend under the sandbox —
	     without it the webview stays blank (verified: removing it renders nothing).
	     The app itself makes NO network requests: no HTTP client in the Rust deps,
	     no fetch/XHR/WebSocket in the frontend, and the CSP forbids remote origins.
	     This grants capability the app never exercises. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- User-granted folder access (e.g. ~/Applications) via NSOpenPanel, persisted
	     across launches with app-scoped security bookmarks. See plan 0013 issue 4. -->
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
</dict>
</plist>
