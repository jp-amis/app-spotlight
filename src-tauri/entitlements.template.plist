<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template for Mac App Store signing. scripts/sign.sh substitutes __TEAM_ID__ and
  __BUNDLE_ID__ from .env.mas and writes entitlements.generated.plist (git-ignored).
  app-sandbox is the only capability the app needs — proven by the 0005 spike.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Required for WKWebView to load the local frontend under the sandbox (verified:
	     without it the webview stays blank). The app makes no network requests itself. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- User-granted folder access + persisted security-scoped bookmarks. -->
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<key>com.apple.application-identifier</key>
	<string>__TEAM_ID__.__BUNDLE_ID__</string>
	<key>com.apple.developer.team-identifier</key>
	<string>__TEAM_ID__</string>
</dict>
</plist>
