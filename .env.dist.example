# Developer ID distribution config — for sending the app to friends/testers directly
# (NOT the Mac App Store). Copy to `.env.dist` and fill it in:
#   cp .env.dist.example .env.dist
# `.env.dist` is git-ignored. It's sourced by scripts/dist.sh, so KEEP THE QUOTES
# (identity strings contain spaces and parentheses).

# Your "Developer ID Application" signing identity — for apps distributed OUTSIDE the
# App Store. Copy it verbatim from:  security find-identity -v -p codesigning
# Don't have one? developer.apple.com → Certificates → + → "Developer ID Application".
APPLE_SIGNING_IDENTITY="Developer ID Application: YOUR NAME (XXXXXXXXXX)"

# ---- Notarization (lets friends open the app with no Gatekeeper warnings) ----
# Simplest: your Apple ID + an app-specific password.
#   App-specific password: appleid.apple.com → Sign-In & Security → App-Specific Passwords.
APPLE_ID="you@example.com"
APPLE_PASSWORD="abcd-efgh-ijkl-mnop"    # the app-specific password (NOT your normal password)
APPLE_TEAM_ID="XXXXXXXXXX"              # 10-char Team ID (developer.apple.com → Membership)

# ---- Alternative: App Store Connect API key (comment out the three lines above) ----
# APPLE_API_ISSUER="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# APPLE_API_KEY="XXXXXXXXXX"
# APPLE_API_KEY_PATH="/absolute/path/AuthKey_XXXXXXXXXX.p8"
